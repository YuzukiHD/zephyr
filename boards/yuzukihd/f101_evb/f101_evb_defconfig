CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y
CONFIG_CLOCK_CONTROL=y
CONFIG_RESET=y
CONFIG_WATCHDOG=y
CONFIG_DYNAMIC_INTERRUPTS=y
CONFIG_I2C=y
CONFIG_SPI=y
CONFIG_PWM=y
CONFIG_ADC=y
CONFIG_DMA=y
CONFIG_MIPI_DBI=y
CONFIG_SHELL=y
CONFIG_DEBUG=y
CONFIG_LOG=y
# The kernel logs every mutex operation at debug level. Forcing all modules
# to debug (LOG_OVERRIDE_LEVEL) with the shell log backend makes the log
# output take the mutex that it is logging about, recursing until the
# thread stack is gone. Keep the default per-module levels instead.
CONFIG_LOG_MAX_LEVEL=4
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_MODE_DEFERRED=y
CONFIG_LOG_BACKEND_UART=y
CONFIG_LOG_PRINTK=y
CONFIG_DEVMEM_SHELL=y

# display, 2D engine and the heap of the media samples
CONFIG_DISPLAY=y
CONFIG_G2D=y
CONFIG_HEAP_MEM_POOL_SIZE=262144
# Room for the display shell output and LVGL logging
CONFIG_LOG_BUFFER_SIZE=16384
