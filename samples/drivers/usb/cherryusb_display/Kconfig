mainmenu "USB second screen"

config SAMPLE_USB_DISPLAY_WIDTH
	int "Width the host is told, 0 for the width of the panel"
	default 0

config SAMPLE_USB_DISPLAY_HEIGHT
	int "Height the host is told, 0 for the height of the panel"
	default 0

config SAMPLE_USB_DISPLAY_FPS
	int "Frame rate the host is told"
	default 60
	range 1 120

config SAMPLE_USB_DISPLAY_QUALITY
	int "JPEG quality the host is told (1..10)"
	default 9
	range 1 10

config SAMPLE_USB_DISPLAY_TOUCH
	bool "Add a HID multi-touch screen to the device"
	default y
	help
	  Makes the device a composite one: the display on interface 0 and a five finger
	  touch screen on interface 1. Windows loads its own driver for the latter.

config SAMPLE_USB_DISPLAY_TOUCH_DEMO
	bool "Send a synthetic two finger drag when the host has configured the device"
	depends on SAMPLE_USB_DISPLAY_TOUCH

config SAMPLE_USB_DISPLAY_CTP
	bool "Take the touch points from the touch panel on I2C1"
	depends on SAMPLE_USB_DISPLAY_TOUCH
	default y

config SAMPLE_USB_DISPLAY_CTP_SWAP
	bool "Exchange X and Y of the touch panel"
	depends on SAMPLE_USB_DISPLAY_CTP

config SAMPLE_USB_DISPLAY_CTP_FLIP_X
	bool "Mirror X of the touch panel"
	depends on SAMPLE_USB_DISPLAY_CTP

config SAMPLE_USB_DISPLAY_CTP_FLIP_Y
	bool "Mirror Y of the touch panel"
	depends on SAMPLE_USB_DISPLAY_CTP

source "Kconfig.zephyr"
