mainmenu "Hardware JPEG decoder sample"

config SAMPLE_VDEC_DUMP
	bool "Dump the decoded picture on the console"
	help
	  Print the NV12 planes as hex lines (about 20 s at 115200 baud for a
	  320x240 picture) so they can be compared with a host decode.

source "Kconfig.zephyr"
