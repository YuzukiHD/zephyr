if SOC_SUN252I_F101

config NUM_IRQS
	default 204

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus,timebase-frequency)

config 2ND_LVL_ISR_TBL_OFFSET
	default 12

config 2ND_LVL_INTR_00_OFFSET
	default 11

config MAX_IRQ_PER_AGGREGATOR
	default 192

config ICACHE_LINE_SIZE
	default 64

config DCACHE_LINE_SIZE
	default 64

if SUN252I_F101_RVV

# Every interrupt and exception frame carries the vector registers (about
# 32 * VLEN/8 + 32 bytes), each thread stack has to hold one plus the handler.
config IDLE_STACK_SIZE
	default 1536

config MAIN_STACK_SIZE
	default 4096

config ISR_STACK_SIZE
	default 4096

config SYSTEM_WORKQUEUE_STACK_SIZE
	default 2048

config LOG_PROCESS_THREAD_STACK_SIZE
	default 2048

config TEST_EXTRA_STACK_SIZE
	default 1024

endif # SUN252I_F101_RVV

if SERIAL

config UART_NS16550
	default y

config UART_NS16550_DW8250_DW_APB
	default y

endif # SERIAL

endif # SOC_SUN252I_F101