config DMA_SUNXI
	bool "Allwinner sunxi legacy DMA"
	default y
	depends on DT_HAS_ALLWINNER_SUNXI_DMA_ENABLED
	select CACHE_MANAGEMENT
	help
	  Enable the F101 12-channel LLI DMA controller.

config DMA_SUNXI_MAX_BLOCKS
	int "Allwinner sunxi DMA blocks per channel"
	default 8
	range 1 64
	depends on DMA_SUNXI
	help
	  Number of chained blocks a channel can hold. A cyclic transfer (an
	  audio ring) uses one block per period.

config DMA_SUNXI_INIT_PRIORITY
	int "Allwinner sunxi DMA initialization priority"
	default 50
