config HELIX_AAC
	bool "Helix AAC decoder"
	help
	  Fixed-point AAC-LC / HE-AAC decoder (west project modules/lib/libhelix,
	  integer only, no floating point or libm needed).

config HELIX_AAC_SBR
	bool "Helix AAC: spectral band replication (HE-AAC)"
	depends on HELIX_AAC
	help
	  Decode HE-AAC streams at the full output rate. The output buffer then
	  holds 2048 samples per channel per frame instead of 1024.
